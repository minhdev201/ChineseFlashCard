{
  "manifest_version": 3,
  "name": "Thẻ mới",
  "version": "1.0.0",
  "description": "Tùy chỉnh giao diện New Tab tối giản với từ vựng tiếng Trung",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://*.supabase.co/*",
    "https://chinese-flash-card.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}